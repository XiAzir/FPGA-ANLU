nE+RpaEAiB+d1GZ7sDY+R509TIcSxcjSU/kBcubvnxO7xOyD0htkg=="}]},"_npmUser":{"name":"alexmercer12138","email":"alexmercer121381@outlook.com"},"directories":{},"maintainers":[{"name":"alexmercer12138","email":"alexmercer121381@outlook.com"}],"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/iverilog-wasm_0.1.4_1787787015979_0.39040222779331013"},"_hasShrinkwrap":false}},"time":{"created":"2026-08-16T12:29:02.786Z","modified":"2026-08-26T23:30:16.428Z","0.1.1":"2026-08-16T12:29:03.211Z","0.1.2":"2026-08-16T23:48:35.888Z","0.1.3":"2026-08-26T11:36:20.185Z","0.1.4":"2026-08-26T23:30:16.205Z"},"bugs":{"url":"https://github.com/AlexMercer12138/iverilog/issues"},"license":"GPL-2.0-or-later","homepage":"https://github.com/AlexMercer12138/iverilog#readme","repository":{"type":"git","url":"git+https://github.com/AlexMercer12138/iverilog.git","directory":"wasm/package"},"description":"Run Icarus Verilog compilation and VVP simulation from Node.js without installing native `iverilog` or `vvp` executables. Each request runs the `ivlpp`, `ivl`, and `vvp` WebAssembly stages in an isolated worker with an in-memory filesystem.","maintainers":[{"name":"alexmercer12138","email":"alexmercer121381@outlook.com"}],"readme":"# @veriflow/iverilog-wasm\n\nRun Icarus Verilog compilation and VVP simulation from Node.js without\ninstalling native `iverilog` or `vvp` executables. Each request runs the\n`ivlpp`, `ivl`, and `vvp` WebAssembly stages in an isolated worker with an\nin-memory filesystem.\n\n## Requirements\n\n- Node.js 18.15.0 or newer\n- ES modules; the package does not provide a CommonJS entry point\n\n## Usage\n\n```js\nimport { simulate } from '@veriflow/iverilog-wasm';\n\nconst result = await simulate({\n  files: [{\n    path: 'counter.sv',\n    data: 'module counter; initial $display(\"ready\"); endmodule\\n',\n  }],\n  sources: ['counter.sv'],\n  generation: '2012',\n});\n\nif (!result.success) {\n  throw new Error(result.stderr);\n}\n\nprocess.stdout.write(result.combinedOutput);\n```\n\nEvery result retains `stdout` and `stderr` separately and also provides\n`combinedOutput` in the order that the underlying runtime emitted both streams.\n\nThe package exports `compile()`, `run()`, and `simulate()`. Files, include\ndirectories, `$readmemh` input, and requested artifacts such as VCD output\nlive in the request's virtual workspace. `AbortSignal` and `timeoutMs` can be\nused to stop a request. Every call creates a worker and releases it after the\nrequest settles.\n\nSpecify block timing is parsed but ignored by default, matching Icarus\nVerilog's default behavior. Pass `specify: true` to `compile()` or\n`simulate()` to enable path delays and timing checks from specify blocks.\n\n`run()` and `simulate()` accept `runCwd` to run VVP from a staged virtual\ndirectory, such as `project/rtl`. The value must be a normalized relative\nPOSIX path, and the directory must be created by the request's virtual files.\nIt defaults to `.`. Compilation and artifact paths remain rooted at the\nvirtual workspace regardless of `runCwd`.\n\nBuilt-in `system.vpi`, `v2005_math.vpi`, and `v2009.vpi` functionality is\navailable. External VPI modules, VHDL, browser environments, FST/LXT output,\nand direct host filesystem access are not supported.\n\nInvalid HDL resolves to a result with `success: false` and the failing stage.\nInvalid API input and worker infrastructure failures reject the promise.\n\n## License And Source\n\nThis package includes Icarus Verilog WebAssembly binaries and is distributed\nunder GPL-2.0-or-later. See `LICENSE` and the packaged `dist/SOURCE.md` for the\nexact source revision and reproducible build command. Applications that\ndistribute this package must satisfy the applicable GPL source-distribution\nrequirements.\n","readmeFilename":"README.md"}